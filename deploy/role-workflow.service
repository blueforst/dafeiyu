[Unit]
Description=单账号角色工作流 Docker 服务
Requires=docker.service
After=network-online.target docker.service nginx.service
Wants=network-online.target nginx.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/role-workflow
ExecStart=/usr/bin/docker compose up -d --no-build
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=180
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
