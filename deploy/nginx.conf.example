map $http_upgrade $role_connection_upgrade { default upgrade; '' close; }
server {
 listen 80 default_server;
 server_name 43.133.80.237;
 location ^~ /.well-known/acme-challenge/ { root /var/lib/role-workflow/acme; try_files $uri =404; }
 location / { return 301 https://43.133.80.237$request_uri; }
}
server {
 listen 443 ssl default_server;
 server_name 43.133.80.237;
 ssl_certificate /etc/letsencrypt/live/role-workflow-ip/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/role-workflow-ip/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 add_header Strict-Transport-Security "max-age=86400" always;
 auth_basic "Role Workflow";
 auth_basic_user_file /etc/role-workflow/htpasswd;
 client_max_body_size 256k;
 location / {
  proxy_pass http://127.0.0.1:8080;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Authorization "";
  proxy_set_header X-Ingress-Key REPLACE_WITH_INGRESS_KEY;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $role_connection_upgrade;
  proxy_buffering off;
  proxy_read_timeout 3600s;
 }
}
